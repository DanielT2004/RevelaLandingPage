# =====================================================================
# Segma — environment variables
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# =====================================================================

# --- Supabase (SERVER-ONLY — never prefix with NEXT_PUBLIC_, never commit) ---
# Found in Supabase dashboard → Project Settings → Data API / API keys.
# The service-role key BYPASSES Row Level Security. Treat it like a root password.
# It is read only in server code (lib/supabaseAdmin.ts) and never reaches the browser bundle.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public site URL (safe to expose) ---
# Drives canonical URLs, Open Graph/Twitter image URLs, and the sitemap.
# Local dev: http://localhost:3000  |  Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: durable rate limiting (production upgrade) ---
# Without these, the API route uses a best-effort in-memory limiter (per-instance).
# To make rate limiting durable across serverless instances, create an Upstash Redis
# database and uncomment these (see lib/rate-limit.ts for the wiring note).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
